# Copy to .env and fill in. Nothing here has a safe default, which is the
# point: every one of these is something that must not be guessable or must not
# be committed. `.env` is gitignored.

# ---------------------------------------------------------------- required --

# Signs session cookies. Flask-Login keeps the signed-in user's id in that
# cookie, so anyone who knows this value can forge a session for any account,
# including an administrator's. Generate one and never reuse it elsewhere:
#     python -c "import secrets; print(secrets.token_hex(32))"
# Leave it unset and the app generates one into instance/secret_key on first
# boot, which is fine for a single machine and wrong for anything that runs
# more than one process or redeploys onto fresh disk.
HANDSHAKE_SECRET_KEY=

# ------------------------------------------------------------------- mail --

# Without these the app does not send: it writes complete .eml files into
# instance/outbox instead, and prints where. That is deliberate so the whole
# flow works on a laptop, but on a real deployment nobody receives their
# invitation or their password reset, so set them.
#
# Gmail: HOST=smtp.gmail.com, PORT=587, USER=your full address, and PASSWORD
# must be an App Password from your Google account's security page — your
# normal password will be refused.
HANDSHAKE_SMTP_HOST=
HANDSHAKE_SMTP_PORT=587
HANDSHAKE_SMTP_USER=
HANDSHAKE_SMTP_PASSWORD=
# What recipients see. Defaults to SMTP_USER.
HANDSHAKE_MAIL_FROM=
HANDSHAKE_MAIL_REPLY_TO=

# --------------------------------------------------------------- optional --

# The first administrator. On a database that has no users at all, this
# creates the account — which is the only way into a fresh deployment, since
# the demo accounts are off and there is no open registration. Once any account
# exists it only promotes an existing one, so it cannot be used later to mint a
# second admin.
HANDSHAKE_ADMIN_EMAIL=
# Optional. Twelve characters minimum, or it is ignored and a strong one is
# generated and printed once to the startup log.
HANDSHAKE_ADMIN_PASSWORD=

# sqlite:///handshake.db by default, relative to instance/.
HANDSHAKE_DATABASE_URI=

# Set to 1 ONLY behind https. It marks the session cookie Secure, and over
# plain http that stops sessions working entirely.
HANDSHAKE_HTTPS=

# Set to 1 to seed the demo accounts and their published passwords. Never do
# this on anything reachable from the internet: one of them is an admin and all
# of their passwords are in app.py.
HANDSHAKE_DEMO_DATA=

# Set to 1 to run app.py with the Werkzeug debugger. That debugger is an
# interactive Python console for anyone who can reach a traceback. Localhost
# only, never on a deployment.
HANDSHAKE_DEBUG=
